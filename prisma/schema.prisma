// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String
  email    String @unique
  password String
}

model Divisi {
  id          Int        @id @default(autoincrement())
  nama        String
  karyawan    Karyawan[]
}

model Jabatan {
  id          Int        @id @default(autoincrement())
  nama        String
  karyawan    Karyawan[]
}

model Karyawan {
  id                 Int                 @id @default(autoincrement())
  nama               String
  jenis_kelamin      String
  no_hp              String
  alamat             String
  email              String             @unique

  statusId           Int
  status_kepegawaian StatusKepegawaian  @relation(fields: [statusId], references: [id])

  divisiId           Int
  jabatanId          Int

  divisi             Divisi             @relation(fields: [divisiId], references: [id])
  jabatan            Jabatan            @relation(fields: [jabatanId], references: [id])

  guru               Guru?              // one-to-one dengan Guru
  absensi            Absensi[]
  laporan_absensi    LaporanAbsensi[]
}

model StatusKepegawaian {
  id        Int        @id @default(autoincrement())
  nama      String     @unique
  karyawans Karyawan[]
}

model Mapel {
  id     Int     @id @default(autoincrement())
  nama   String
  guru   Guru[]
}

model Guru {
  id             Int              @id @default(autoincrement())
  karyawanId     Int              @unique
  mapelId        Int
  jumlahJtm      Int?
  penempatan     JenisPenempatan

  karyawan       Karyawan         @relation(fields: [karyawanId], references: [id])
  mapel          Mapel            @relation(fields: [mapelId], references: [id])

  waliKelas      WaliKelas?       @relation("RelasiWaliKelas") // satu guru bisa jadi satu wali kelas
}

enum JenisPenempatan {
  SATMINKAL
  NON_SATMINKAL
}

model Absensi {
  id            Int       @id @default(autoincrement())
  tanggal       DateTime
  status        String    // TW, TD, LP, DL, S, I, A, C
  karyawanId    Int

  karyawan      Karyawan  @relation(fields: [karyawanId], references: [id])
}

model WaliKelas {
  id         Int      @id @default(autoincrement())
  guruId     Int      @unique
  kelasId    Int

  guru       Guru     @relation("RelasiWaliKelas", fields: [guruId], references: [id])
  kelas      Kelas    @relation(fields: [kelasId], references: [id])
}

model Kelas {
  id           Int          @id @default(autoincrement())
  nama         String       @unique
  jumlah_siswa Int

  wali_kelas   WaliKelas[]
}

model LaporanAbsensi {
  id                  Int      @id @default(autoincrement())
  karyawanId          Int
  bulan               Int
  tahun               Int
  jumlah_hadir        Int
  jumlah_tidak_hadir  Int
  persentase          Float

  karyawan            Karyawan @relation(fields: [karyawanId], references: [id])
}