// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String
  email    String @unique
  password String
}

model Divisi {
  id          Int        @id @default(autoincrement())
  nama        String
  karyawan    Karyawan[]
}

model Jabatan {
  id          Int        @id @default(autoincrement())
  nama        String
  karyawan    Karyawan[]
}

model Karyawan {
  id                 Int               @id @default(autoincrement())
  nama               String
  jenis_kelamin      String
  no_hp              String
  alamat             String
  email              String @unique
  status_kepegawaian String
  divisiId           Int
  jabatanId          Int

  divisi             Divisi            @relation(fields: [divisiId], references: [id])
  jabatan            Jabatan           @relation(fields: [jabatanId], references: [id])
  absensi            Absensi[]
  wali_kelas         WaliKelas?
  laporan_absensi    LaporanAbsensi[]
}

model Absensi {
  id            Int       @id @default(autoincrement())
  tanggal       DateTime
  status        String    // TW, TD, LP, DL, S, I, A, C
  karyawanId    Int

  karyawan      Karyawan  @relation(fields: [karyawanId], references: [id])
}

model WaliKelas {
  id            Int      @id @default(autoincrement())
  karyawanId    Int      @unique
  kelas         String
  jumlah_siswa  Int

  karyawan      Karyawan @relation(fields: [karyawanId], references: [id])
}

model LaporanAbsensi {
  id                  Int      @id @default(autoincrement())
  karyawanId          Int
  bulan               Int
  tahun               Int
  jumlah_hadir        Int
  jumlah_tidak_hadir  Int
  persentase          Float

  karyawan            Karyawan @relation(fields: [karyawanId], references: [id])
}