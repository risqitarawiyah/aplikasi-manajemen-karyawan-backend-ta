generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String
  email    String @unique
  password String
}

model Divisi {
  id       Int        @id @default(autoincrement())
  nama     String
  karyawan Karyawan[]
}

model Jabatan {
  id       Int                @id @default(autoincrement())
  nama     String
  karyawan KaryawanJabatan[]  // relasi Many-to-Many
}

model Karyawan {
  id                 Int                @id @default(autoincrement())
  nama               String
  jenis_kelamin      String
  no_hp              String
  alamat             String
  email              String             @unique

  statusId           Int
  status_kepegawaian StatusKepegawaian? @relation(fields: [statusId], references: [id])

  divisiId           Int
  divisi             Divisi             @relation(fields: [divisiId], references: [id])

  // HAPUS jabatanId tunggal, ganti Many-to-Many
  jabatans           KaryawanJabatan[]

  guru               Guru[]
}

model KaryawanJabatan {
  id          Int       @id @default(autoincrement())
  karyawanId  Int
  jabatanId   Int

  karyawan    Karyawan  @relation(fields: [karyawanId], references: [id])
  jabatan     Jabatan   @relation(fields: [jabatanId], references: [id])

  @@unique([karyawanId, jabatanId]) // satu kombinasi unik
}

model StatusKepegawaian {
  id        Int        @id @default(autoincrement())
  nama      String     @unique
  karyawans Karyawan[]
}

model Mapel {
  id     Int     @id @default(autoincrement())
  nama   String
  guru   Guru[]
}

model Guru {
  id             Int              @id @default(autoincrement())
  karyawanId     Int
  mapelId        Int
  jumlahJtm      Int?
  penempatan     JenisPenempatan

  karyawan       Karyawan         @relation(fields: [karyawanId], references: [id])
  mapel          Mapel            @relation(fields: [mapelId], references: [id])

  waliKelas      WaliKelas?       @relation("RelasiWaliKelas")
}

enum JenisPenempatan {
  SATMINKAL
  NON_SATMINKAL
}

model WaliKelas {
  id            Int      @id @default(autoincrement())
  guruId        Int      @unique
  kelasId       Int
  tahun_ajaran  String

  guru       Guru?     @relation("RelasiWaliKelas", fields: [guruId], references: [id])
  kelas      Kelas?    @relation(fields: [kelasId], references: [id])
}

model Kelas {
  id           Int          @id @default(autoincrement())
  tingkat      Int
  jurusan      String
  ruang        String
  jumlah_siswa Int

  wali_kelas   WaliKelas[]
}
